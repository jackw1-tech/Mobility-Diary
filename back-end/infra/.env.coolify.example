DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mobility.example.com
CSRF_TRUSTED_ORIGINS=https://mobility.example.com
CORS_ALLOWED_ORIGINS=https://mobility-web.vercel.app
USE_X_FORWARDED_HOST=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

WEB_CONCURRENCY=2
WORKER_CONCURRENCY=1

POSTGRES_DB=mobility
POSTGRES_USER=mobility
POSTGRES_PASSWORD=replace-with-a-strong-db-password

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=https://mobility.example.com
S3_ACCESS_KEY_ID=replace-with-a-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-strong-minio-secret
S3_BUCKET_NAME=mobility-trips
