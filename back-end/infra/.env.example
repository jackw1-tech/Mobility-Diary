DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,gateway,web
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=1

POSTGRES_DB=mobility
POSTGRES_USER=mobility
POSTGRES_PASSWORD=mobility
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=6432
POSTGRES_DISABLE_SERVER_SIDE_CURSORS=1

PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_AUTH_TYPE=any

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object storage S3-compatibile (MinIO in locale, Railway Buckets in deploy).
# Vedi REPORT_STRATEGIA_INGESTION_ASINCRONA.md - D7.
S3_ENDPOINT_URL=http://minio:9000
# URL pubblico usato nei presigned URL. Passa da Nginx, cosi' MinIO resta privato.
# Se testi da telefono fisico, sostituisci localhost con l'IP LAN del computer.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8080
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=mobility-trips
